{
  "name": "@liquefy-ui/icons",
  "version": "0.1.3",
  "description": "Crisp, rounded React icons for liquefy-ui.",
  "license": "MIT",
  "homepage": "https://liquefy-ui.com",
  "repository": {
    "directory": "packages/icons",
    "type": "git",
    "url": "git+https://github.com/liquefy-ui/liquefy-ui.git"
  },
  "bugs": "https://github.com/liquefy-ui/liquefy-ui/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "19.2.7",
    "tsdown": "0.22.9",
    "typescript": "7.0.2",
    "unrun": "0.3.1"
  },
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "icons",
    "react",
    "svg",
    "liquid-glass"
  ]
}
