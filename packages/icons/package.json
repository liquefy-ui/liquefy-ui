{
  "name": "@liquefy-ui/icons",
  "version": "1.1.0",
  "description": "Crisp, rounded React icons for liquefy-ui.",
  "license": "MIT",
  "homepage": "https://liquefy-ui.com",
  "repository": {
    "directory": "packages/icons",
    "type": "git",
    "url": "git+https://github.com/liquefy-ui/liquefy-ui.git"
  },
  "bugs": "https://github.com/liquefy-ui/liquefy-ui/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "effects"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./effects": {
      "import": {
        "types": "./dist/effects.d.mts",
        "default": "./dist/effects.mjs"
      },
      "require": {
        "types": "./dist/effects.d.cts",
        "default": "./dist/effects.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "unrun": "0.3.1"
  },
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "react",
    "icons",
    "react-icons",
    "svg",
    "svg-icons",
    "tree-shakeable",
    "liquid-glass",
    "symbol-effects",
    "animation"
  ]
}
